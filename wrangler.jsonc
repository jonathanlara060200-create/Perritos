{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "perritos",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://perritos.jonathanlara060200.workers.dev"
  },
  // Despliegues de vista previa (ramas distintas a main). Usan la misma URL pública; las variables
  // NEXT_PUBLIC_* de Supabase vienen del panel de Cloudflare y apuntan a la misma base de datos.
  "previews": {
    "vars": {
      "NEXT_PUBLIC_SITE_URL": "https://perritos.jonathanlara060200.workers.dev"
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
